{
  "_comment": "Agent CLIs that herdr-agents.ps1 can start in Herdr panes. kind = Herdr agent kind; modelFlag = how the CLI takes a model; args = always passed (safety first: tools need approval); model = default when -Model is not given (empty = the CLI's own default); effortArgs = how -Effort is passed ({0} = the level); effort = the default level when -Effort is not given; contextWindow = tokens the HUD divides by for 'ctx %'. Which agent suits which task, and what works now: docs/AGENT-ROSTER.md. Edit freely. account = how -Account <name> gives a profile its own sign-in folder (%USERPROFILE%\\.herdr-accounts\\<tool>\\<name>): env vars / args with {dir}, the login command, and settings copied from the default folder (never sign-in files). Antigravity has no account support (its sign-in is not in a folder we can move).",
  "agents": {
    "claude": {
      "kind": "claude",
      "command": "claude",
      "modelFlag": "--model",
      "model": "claude-opus-5-5",
      "args": [
        "--permission-mode",
        "auto"
      ],
      "effortArgs": [
        "--effort",
        "{0}"
      ],
      "contextWindow": 1000000,
      "account": {
        "tool": "claude",
        "env": {
          "CLAUDE_CONFIG_DIR": "{dir}"
        },
        "args": [],
        "login": "claude auth login",
        "copy": [
          "settings.json",
          "CLAUDE.md",
          "statusline.js",
          "skills"
        ]
      }
    },
    "codex": {
      "kind": "codex",
      "command": "codex",
      "modelFlag": "-m",
      "model": "gpt-6.1-sol",
      "args": [
        "-a",
        "never",
        "-s",
        "workspace-write"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort={0}"
      ],
      "account": {
        "tool": "codex",
        "env": {
          "CODEX_HOME": "{dir}"
        },
        "args": [],
        "login": "codex login",
        "copy": [
          "config.toml",
          "AGENTS.md",
          "skills"
        ]
      }
    },
